# Vorlage. Zum Benutzen als .env kopieren - die liegt in .gitignore.
#
# Die Client-ID fuer die Google-Anmeldung. Kein Geheimnis: sie steht in jedem
# Aufruf, den der Browser an Google schickt. Sie hier zu hinterlegen erspart
# nur das Eintippen in den Einstellungen der App.
#
# Woher man sie bekommt, steht im README unter "Anmeldung und Profile".
# Ohne sie laeuft die App normal weiter, nur der Anmeldeknopf bleibt wirkungslos.
#
# Fuer den Entwicklungsserver muss unter "Authorized JavaScript origins" in der
# Google Cloud Console zusaetzlich http://localhost:5173 stehen.
VITE_GOOGLE_CLIENT_ID=
